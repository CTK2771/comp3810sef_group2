<%- include('header') %>
<% var metricName = experiment.metricName || (experiment.accuracy != undefined ? 'Accuracy' : 'Score'); %>
<% var metricValue = experiment.metricValue !== '' && experiment.metricValue != undefined ? experiment.metricValue : experiment.accuracy; %>
<% var statusClass = ['queued','running','completed','failed'].indexOf(experiment.status) >= 0 ? experiment.status : 'queued'; %>
<section class="panel">
    <h1><%= experiment.title %> <span class="status status-<%= statusClass %>"><%= experiment.status.charAt(0).toUpperCase()+experiment.status.slice(1) %></span></h1>
    <p class="score"><%= metricName %>: <%= metricValue %></p>
    <div class="facts">
        <span>Model</span><b><%= experiment.model %></b>
        <span>Dataset</span><b><%= experiment.dataset %></b>
        <span>Loss</span><b><%= experiment.loss %></b>
        <span>Learning rate</span><b><%= experiment.learningRate %></b>
        <span>Epochs</span><b><%= experiment.epochs %></b>
        <span>Batch size</span><b><%= experiment.batchSize %></b>
        <span>Tags</span><b><%= experiment.tags %></b>
        <span>Notes</span><b><%= experiment.notes %></b>
        <span>Created</span><b><%= experiment.createdAt %></b>
        <span>Owner</span><b><%= experiment.username %></b>
    </div>
    <p>
        <a class="button" href="/experiments/edit?_id=<%= experiment._id %>">Edit</a>
        <a class="button danger" href="/experiments/delete?_id=<%= experiment._id %>">Delete</a>
    </p>
</section>
<%- include('footer') %>
